cabal-version:   3.0
name:            telegrammar
version:         0.1.0.0
synopsis:        The whole Telegram Bot API as Haskell types, requests, and codecs
description:
  A record for every Telegram Bot API object, a request record for every
  method, and the JSON codecs between them. Requests are planned by pure code
  that checks them before anything is sent, results are decoded by the
  matching parsers, and the HTTP transport stays yours. The README shows a
  first bot.
  This release covers Bot API 10.3.

license:         MIT
license-file:    LICENSE
author:          Eugene Sukhodolin
maintainer:      Eugene Sukhodolin <eugene@sukhodolin.com>
copyright:       2026 Eugene Sukhodolin
category:        Web
homepage:        https://github.com/sukhodolin/telegrammar
bug-reports:     https://github.com/sukhodolin/telegrammar/issues
build-type:      Simple
tested-with:     GHC ==9.14.1
extra-doc-files:
  CHANGELOG.md
  README.md

source-repository head
  type:     git
  location: https://github.com/sukhodolin/telegrammar.git

